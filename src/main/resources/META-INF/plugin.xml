<!-- Plugin Configuration File: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN, cannot be changed between the plugin versions. -->
    <id>com.covdbg.coverage</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>covdbg</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://covdbg.com">covdbg</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description><![CDATA[
        <p>Measure C++ code coverage in CLion with <a href="https://covdbg.com">covdbg</a>, which
        instruments a running process directly instead of requiring an instrumented build.</p>

        <p><b>Requirements.</b> Windows, an MSVC (Visual Studio) toolchain, and covdbg 1.3.0 or
        newer installed separately &mdash; this plugin drives the covdbg executable, it does not
        bundle it. Runs are licensed per seat, so sign in from <i>Tools | covdbg | Sign In</i> (or
        set <code>COVDBG_PROJECT_TOKEN</code> in CI). A <code>.covdbg.yaml</code> in the repository
        decides what is measured; the plugin can create a starter one for you.</p>

        <p><b>What you get.</b> Run any CLion run configuration under covdbg and see the result in
        CLion's own coverage UI: the editor gutter, including partially covered lines, the Coverage
        tool window, and the history of earlier runs. Existing <code>.covdb</code> files can be
        imported, and exported as an offline HTML report.</p>
    ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.clion</depends>
    <depends>com.intellij.clion</depends>
    <depends>com.intellij.modules.coverage</depends>

    <!-- Extensions defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <configurationType implementation="com.covdbg.coverage.run.CovdbgConfigurationType"/>
        <programRunner implementation="com.covdbg.coverage.run.CovdbgProgramRunner"/>
        <programRunner implementation="com.covdbg.coverage.run.CovdbgCoverageRunner"/>
        <executor implementation="com.covdbg.coverage.run.CovdbgExecutor"
                  id="CovdbgCoverageExecutor"/>
        <!-- Coverage is presented by the platform: gutter, Coverage tool window, suite history. -->
        <coverageEngine implementation="com.covdbg.coverage.engine.CovdbgCoverageEngine"/>
        <coverageRunner implementation="com.covdbg.coverage.engine.CovdbCoverageRunner"/>
        <projectConfigurable
            instance="com.covdbg.coverage.settings.CovdbgSettingsConfigurable"
            displayName="Covdbg"
            id="covdbg.settings"/>
        <notificationGroup id="covdbg" displayType="BALLOON" isLogByDefault="true"/>
        <!-- The device-code prompt must survive the trip to the browser, so it is sticky and lives
             in its own group rather than fading with ordinary run notifications. -->
        <notificationGroup id="covdbg Sign-In" displayType="STICKY_BALLOON" isLogByDefault="true"/>
        <postStartupActivity implementation="com.covdbg.coverage.seats.CovdbgSeatStartupActivity"/>
        <statusBarWidgetFactory id="CovdbgSignInStatus"
                                implementation="com.covdbg.coverage.ui.CovdbgSignInStatusWidgetFactory"/>
    </extensions>

    <!-- Puts covdbg in front of the target when CovdbgCoverageRunner runs a CLion configuration. -->
    <extensions defaultExtensionNs="cidr">
        <runConfigurationExtension implementation="com.covdbg.coverage.run.CovdbgRunConfigurationExtension"/>
    </extensions>

    <actions>
        <action id="covdbg.SignIn"
                class="com.covdbg.coverage.actions.CovdbgSignInAction"
                text="Sign In to covdbg"
                description="Sign in to covdbg in the browser"
                icon="AllIcons.CodeWithMe.CwmPermissionsGranted"/>
        <action id="covdbg.SignOut"
                class="com.covdbg.coverage.actions.CovdbgSignOutAction"
                text="Sign Out of covdbg"
                description="End the covdbg session on the service and forget it here"
                icon="AllIcons.CodeWithMe.CwmPermissionsDenied"/>
        <action id="covdbg.RefreshSignInStatus"
                class="com.covdbg.coverage.actions.CovdbgRefreshSignInStatusAction"
                text="Refresh covdbg Sign-In Status"
                description="Ask covdbg who this machine is signed in as"
                icon="AllIcons.Actions.Refresh"/>
        <action id="covdbg.CreateConfig"
                class="com.covdbg.coverage.actions.CovdbgCreateConfigAction"
                text="Create .covdbg.yaml"
                description="Write a starter covdbg configuration in the project root"
                icon="AllIcons.Actions.AddFile"/>
        <action id="covdbg.ExportHtmlReport"
                class="com.covdbg.coverage.actions.CovdbgExportHtmlReportAction"
                text="Export HTML Coverage Report"
                description="Convert the covdbg coverage shown to an offline HTML report"
                icon="AllIcons.Actions.MenuSaveall">
            <!-- Next to the platform's own coverage actions (Show Coverage Data, Hide Coverage). -->
            <add-to-group group-id="CoverageMenu" anchor="last"/>
        </action>

        <group id="covdbg.MainGroup" text="covdbg" popup="true" icon="/icons/covdbg.svg">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <reference ref="covdbg.SignIn"/>
            <reference ref="covdbg.SignOut"/>
            <reference ref="covdbg.RefreshSignInStatus"/>
            <separator/>
            <reference ref="covdbg.CreateConfig"/>
            <reference ref="covdbg.ExportHtmlReport"/>
        </group>
    </actions>
</idea-plugin>
